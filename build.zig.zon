.{
    .name = .synapse_bard,
    .version = "0.1.0",

    // Generated once by the toolchain and never changed: together with `name`
    // it is this package's globally unique identity, so that a fork is
    // distinguishable from an update. Changing it has security and trust
    // implications.
    .fingerprint = 0x351ee54619ebcc42,

    // Pinned to the same version synapse itself requires -- see synapse's own
    // `build.zig.zon` comment for why it's pinned rather than tracking
    // latest.
    .minimum_zig_version = "0.16.0",

    .dependencies = .{
        // Pinned to a tagged synapse release, the way `tree_sitter`/`zeit`
        // are pinned in synapse's own `build.zig.zon`. This supplies the
        // `model`/`ports`/`core`/`adapters` modules; `build.zig` never
        // requests `treesitter`, so libtree-sitter and the C toolchain it
        // needs never enter this build. Bumping this is a deliberate step
        // tied to a real synapse release, never an arbitrary commit.
        .synapse = .{
            .url = "https://github.com/imunitic/synapse/archive/refs/tags/v0.13.9.tar.gz",
            .hash = "synapse-0.1.0-AUmHlSQyKwBpcpt9X8KuZwrdHsE62xqPB_HztcRZLah1",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
