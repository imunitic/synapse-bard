with "config/synapse_bard_config.gpr";

project Synapse_Bard is

   for Source_Dirs use ("src/apps", "config/");
   for Object_Dir use "obj/" & Synapse_Bard_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("synapse_bard_main.adb", "synapse_bard_hook_main.adb");

   package Compiler is
      for Default_Switches ("Ada") use Synapse_Bard_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Builder is
      for Executable ("synapse_bard_main.adb") use "synapse-bard";
      for Executable ("synapse_bard_hook_main.adb") use "synapse-bard-hook";
   end Builder;

end Synapse_Bard;
