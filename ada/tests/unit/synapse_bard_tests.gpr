with "config/synapse_bard_tests_config.gpr";
with "aunit.gpr";
with "synapse.gpr";

project Synapse_Bard_Tests is

   for Source_Dirs use ("src", "../../src/apps", "config/");
   for Object_Dir use "obj/" & Synapse_Bard_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("synapse_bard_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use Synapse_Bard_Tests_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Synapse_Bard_Tests;
