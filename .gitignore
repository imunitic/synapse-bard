.DS_Store
zig-out/
.zig-cache/
# Scratch cross-compile output -- release.yml's own per-target build dir
# (out/$target/bin/...), also used locally when testing a release by hand.
out/
# The compiled synapse-bard/synapse-bard-hook binaries the platform packages
# ship -- release.yml's own publish step copies them in fresh from out/ at
# publish time (or a local hand-test does the same); never checked into
# source.
packages/synapse-bard/platforms/*/bin/
# Where zig 0.16 unpacks fetched dependencies -- the global cache under
# ~/.cache/zig/p holds only the tarballs. Build output, not vendored source:
# `zig build --fetch` refills it from the hash pinned in build.zig.zon.
zig-pkg/
# Personal, machine-local Claude Code instructions -- never shared, never
# committed by anyone else working in this repo.
CLAUDE.local.md
