.DS_Store
# The compiled synapse-bard/synapse-bard-hook binaries the platform packages
# ship -- release.yml's own publish step copies them in fresh at publish time
# (or a local hand-test does the same); never checked into source.
packages/synapse-bard/platforms/*/bin/
