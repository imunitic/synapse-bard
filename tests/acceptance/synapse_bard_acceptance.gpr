with "config/synapse_bard_acceptance_config.gpr";
with "aunit.gpr";
with "synapse.gpr";

project Synapse_Bard_Acceptance is

   for Source_Dirs use ("src", "config/");
   for Object_Dir use "obj/" & Synapse_Bard_Acceptance_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("synapse_bard_acceptance.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Synapse_Bard_Acceptance_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Synapse_Bard_Acceptance;
